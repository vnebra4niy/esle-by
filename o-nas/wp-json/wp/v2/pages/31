\u043d \u0411\u0435\u043b\u044d\u043d\u0435\u0440\u0433\u043e &#8212; \u041e\u0410\u041e \u0411\u0435\u043b\u0430\u0440\u0443\u0441\u044c\u043a\u0430\u043b\u0438\u0439 \u2013 \u041e\u0410\u041e \u041d\u0430\u0444\u0442\u0430\u043d \u2013 \u0420\u0423\u041f \u041c\u0422\u0417 \u2013 \u041c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f &#8212; \u0440\u0430\u0439\u043e\u043d\u043d\u044b\u0435 \u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0433. \u041c\u0438\u043d\u0441\u043a\u0430 \u2013 \u041e\u041e\u041e \u0415\u0432\u0440\u043e\u0442\u043e\u0440\u0433 (\u0441\u0435\u0442\u044c \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u0432 \u0415\u0432\u0440\u043e\u043e\u043f\u0442) &#8212; \u0433\u0440\u0443\u043f\u043f\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439 \u00ab\u0421\u0430\u043d\u0442\u0430\u00bb &#8212; \u0442\u043e\u0440\u0433\u043e\u0432\u0430\u044f \u0441\u0435\u0442\u044c \u0412\u0438\u0442\u0430\u043b\u044e\u0440, \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u044b \u041f\u0430\u0440\u043a\u0430 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439 \u0432 \u0433. \u041c\u0438\u043d\u0441\u043a\u0435, \u0430 \u0442\u0430\u043a \u0436\u0435 \u043a\u0440\u0443\u0433 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u043d\u0442\u0430\u0436\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439 \u0411\u0435\u043b\u0430\u0440\u0443\u0441\u0438.<\/p>\n<p style=\"text-align: center;\">\u0438\u043c\u0435\u0435\u043c \u043e\u043f\u044b\u0442 \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u043c\u0438, \u043b\u0438\u0442\u043e\u0432\u0441\u043a\u0438\u043c\u0438, \u043f\u043e\u043b\u044c\u0441\u043a\u0438\u043c\u0438, \u0442\u0443\u0440\u0435\u0446\u043a\u0438\u043c\u0438 \u0438 \u043a\u0430\u0442\u0430\u0440\u0441\u043a\u0438\u043c\u0438 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\u043c\u0438<\/p>\n<h4>\u0412\u044b\u0431\u0440\u0430\u0432 \u043d\u0430\u0441, \u0412\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435:<\/h4>\n<ul>\n<li>\u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0412\u0430\u0448\u0435\u043c\u0443 \u0437\u0430\u043a\u0430\u0437\u0443 \u043d\u0430 \u0432\u0441\u0435\u0445 \u044d\u0442\u0430\u043f\u0430\u0445 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438<\/li>\n<li>\u0421\u0436\u0430\u0442\u044b\u0435 \u0441\u0440\u043e\u043a\u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0437\u0430\u043a\u0430\u0437\u0430 \u0438 \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430<\/li>\n<li>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u0438\u0437\u0434\u0435\u043b\u0438\u0439 \u043d\u0430 \u0412\u0430\u0448\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u044b<\/li>\n<li>\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u043e\u0442\u0441\u0440\u043e\u0447\u043a\u043e\u0439 \u043f\u043b\u0430\u0442\u0435\u0436\u0430<\/li>\n<li>\u0413\u0430\u0440\u0430\u043d\u0442\u0438\u0438 \u043d\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0449\u0438\u0442\u043e\u0432\u043e\u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e 5 \u043b\u0435\u0442<\/li>\n<\/ul>\n<h4 style=\"text-align: center;\">\u0411\u043e\u043b\u0435\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u043d\u0430\u0448\u0435\u0439 \u043f